<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dimitris.customermanagement.controller.MainMenuController"
            prefWidth="560.0"
            prefHeight="360.0"
            stylesheets="@style.css">

    <children>

        <VBox alignment="CENTER"
              spacing="20.0"
              prefWidth="560.0"
              prefHeight="360.0">

            <padding>
                <Insets top="40.0"
                        right="50.0"
                        bottom="40.0"
                        left="50.0"/>
            </padding>

            <Label text="Customer Management System"
                   styleClass="title-label"/>

            <Label text="Διαχείριση Πελατών"
                   styleClass="subtitle-label"/>

            <Button text="Εισαγωγή Πελάτη"
                    onAction="#handleInsertCustomer"
                    prefWidth="230.0"
                    prefHeight="44.0"
                    styleClass="main-button"/>

            <Button text="Εμφάνιση Πελατών"
                    onAction="#handleShowCustomers"
                    prefWidth="230.0"
                    prefHeight="44.0"
                    styleClass="main-button"/>

            <Button text="Έξοδος"
                    onAction="#handleExit"
                    prefWidth="230.0"
                    prefHeight="44.0"
                    styleClass="delete-button"/>

        </VBox>

    </children>

</AnchorPane>
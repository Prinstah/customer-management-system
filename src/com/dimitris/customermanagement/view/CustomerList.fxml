<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dimitris.customermanagement.controller.CustomerListController"
            prefWidth="900.0"
            prefHeight="550.0"
            stylesheets="@style.css">

    <children>

        <VBox spacing="18.0"
              prefWidth="900.0"
              prefHeight="550.0">

            <padding>
                <Insets top="25.0"
                        right="30.0"
                        bottom="25.0"
                        left="30.0"/>
            </padding>

            <Label text="Λίστα Πελατών"
                   styleClass="title-label"/>

            <Label text="Αναζήτηση πελάτη με ΑΦΜ"
                   styleClass="subtitle-label"/>

            <TextField fx:id="searchAfmField"
                       promptText="Εισάγετε ΑΦΜ..."
                       prefWidth="300.0"
                       maxWidth="300.0"/>

            <TableView fx:id="customerTable"
                       prefHeight="360.0"
                       prefWidth="840.0">

                <columns>

                    <TableColumn fx:id="firstNameColumn"
                                 text="Όνομα"
                                 prefWidth="150.0"/>

                    <TableColumn fx:id="lastNameColumn"
                                 text="Επώνυμο"
                                 prefWidth="170.0"/>

                    <TableColumn fx:id="afmColumn"
                                 text="ΑΦΜ"
                                 prefWidth="140.0"/>

                    <TableColumn fx:id="phoneColumn"
                                 text="Τηλέφωνο"
                                 prefWidth="160.0"/>

                    <TableColumn fx:id="emailColumn"
                                 text="Email"
                                 prefWidth="220.0"/>

                </columns>

            </TableView>

            <HBox alignment="CENTER_LEFT"
                  spacing="20.0">

                <Label fx:id="totalCustomersLabel"
                       text="Σύνολο Πελατών: 0"
                       styleClass="info-label"/>

                <Button text="Διαγραφή Επιλεγμένου Πελάτη"
                        onAction="#handleDeleteCustomer"
                        prefWidth="230.0"
                        prefHeight="40.0"
                        styleClass="delete-button"/>

            </HBox>

        </VBox>

    </children>

</AnchorPane>